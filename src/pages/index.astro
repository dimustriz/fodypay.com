---
import Layout from '../layouts/Layout.astro';
---

<Layout title="FodyPay - A card for everywhere your bank isn't.">

  <!-- Nav -->
  <header class="nav">
    <div class="nav-inner">
      <a href="/" class="logo">Fody<span>Pay</span></a>
      <nav class="nav-links">
        <a href="#why">Why FodyPay</a>
        <a href="#how-it-works">How it works</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </nav>
      <a href="#waitlist" class="btn-primary nav-cta">Get Early Access</a>
    </div>
  </header>

  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <span class="badge">Early Access</span>
        <h1>Just another card.<br><span class="h1-accent">For everywhere else.</span></h1>
        <p class="hero-sub">
          FodyPay is a virtual Visa card built for life outside your home bank &mdash; travel, online shopping, remote work. Set up in minutes, no plastic to wait for.
        </p>
        <div class="hero-proof">
          <span>Works alongside any bank</span>
          <span class="dot">&middot;</span>
          <span>Accepted in 150+ countries</span>
          <span class="dot">&middot;</span>
          <span>Ready in 2 minutes</span>
        </div>
        <form class="waitlist-form" id="waitlist" action="#" method="POST">
          <input type="email" name="email" placeholder="Your email" required />
          <button type="submit" class="btn-primary">Get Early Access</button>
        </form>
        <p class="hero-note">Join the waitlist. We&rsquo;ll let you in first.</p>
      </div>
      <div class="hero-visual">
        <div class="phone-mockup">
          <div class="phone-screen">
            <div class="mock-balance">$12,480.50</div>
            <div class="mock-label">Total Balance</div>
            <div class="mock-cards">
              <div class="mock-card mc-1">&bull;&bull;&bull;&bull; 4291</div>
              <div class="mock-card mc-2">FodyPay Visa</div>
            </div>
            <div class="mock-actions">
              <div class="mock-action">&#8593; Send</div>
              <div class="mock-action">&#8595; Receive</div>
              <div class="mock-action">+ Top Up</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why FodyPay -->
  <section class="features" id="why">
    <div class="container">
      <div class="section-header">
        <h2>The card your bank should&rsquo;ve been</h2>
        <p>Normal people want a second card that simply works &mdash; everywhere, every time, without surprise charges.</p>
      </div>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-label">For travelers</div>
          <h3>Better rates when you travel</h3>
          <p>Your home bank wasn&rsquo;t designed for travel. FodyPay converts at competitive mid-market rates and is built to work globally &mdash; use it when your bank charges more than it should.</p>
        </div>
        <div class="feature-card">
          <div class="feature-label">For online shoppers</div>
          <h3>A dedicated card for the internet</h3>
          <p>Use a separate virtual card for subscriptions, one-off purchases, and sketchy checkouts. Freeze it in a tap if anything looks off &mdash; your main account stays safe.</p>
        </div>
        <div class="feature-card">
          <div class="feature-label">For nomads</div>
          <h3>One card, 150+ countries</h3>
          <p>Accepted everywhere Visa is. No blocked countries, no &ldquo;please notify your bank&rdquo; calls before you leave, no currency surprises at checkout.</p>
        </div>
        <div class="feature-card">
          <div class="feature-label">For freelancers</div>
          <h3>Separate work from life</h3>
          <p>Load your project budget onto a dedicated card. Track client expenses separately from personal spending without needing a business account.</p>
        </div>
        <div class="feature-card">
          <div class="feature-label">For the cautious</div>
          <h3>Never your primary account</h3>
          <p>FodyPay doesn&rsquo;t want to be your bank. Keep your savings where they are. Top up only what you need &mdash; like a prepaid, but smarter.</p>
        </div>
        <div class="feature-card">
          <div class="feature-label">For everyone</div>
          <h3>Instant virtual card</h3>
          <p>No 5&ndash;7 day delivery wait. Your card number is ready the moment your account is set up. Add to Apple Pay or Google Pay and pay immediately.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="how" id="how-it-works">
    <div class="container">
      <div class="section-header">
        <h2>Up and paying in under 5 minutes</h2>
        <p>No branch visit. No card in the post. No calling your bank.</p>
      </div>
      <div class="steps">
        <div class="step">
          <div class="step-num">1</div>
          <h3>Sign up &amp; verify</h3>
          <p>Create an account and verify your identity with a photo ID. Takes under 2 minutes on your phone.</p>
        </div>
        <div class="step-arrow">&#8594;</div>
        <div class="step">
          <div class="step-num">2</div>
          <h3>Top up your balance</h3>
          <p>Transfer from your existing bank account or debit card. No minimums &mdash; load exactly what you plan to spend.</p>
        </div>
        <div class="step-arrow">&#8594;</div>
        <div class="step">
          <div class="step-num">3</div>
          <h3>Get your virtual card</h3>
          <p>Your Visa virtual card is ready instantly. Add it to Apple Pay or Google Pay and pay anywhere &mdash; online or in-store.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-box">
        <h2>The wait list is open.</h2>
        <p>We&rsquo;re launching soon. Get in early and skip the queue.</p>
        <form class="waitlist-form" action="#" method="POST">
          <input type="email" name="email" placeholder="Enter your email" required />
          <button type="submit" class="btn-white">Reserve My Spot</button>
        </form>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-inner">
        <div class="footer-brand">
          <a href="/" class="logo">Fody<span>Pay</span></a>
          <p>A card for people who move &mdash; travelers, nomads, remote workers.</p>
        </div>
        <div class="footer-links">
          <a href="#features">Features</a>
          <a href="#how-it-works">How it works</a>
          <a href="/privacy">Privacy Policy</a>
          <a href="/terms">Terms of Service</a>
          <a href="mailto:hello@fodypay.com">Contact</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 FodyPay. All rights reserved.</p>
        <p>Payment processing by <strong>Stripe</strong>.</p>
      </div>
    </div>
  </footer>

</Layout>

<style>
  /* ??? Reset & base ??? */
  :root {
    --orange: #ff8c00;
    --orange-dark: #d45e00;
    --bg: #faf9f7;
    --surface: #f2f1ee;
    --text: #111827;
    --text-muted: #6b7280;
    --border: #e5e3de;
    --radius: 14px;
    --max: 1120px;
  }

  body { background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif; }

  .container { max-width: var(--max); margin: 0 auto; padding: 0 24px; }

  /* ??? Nav ??? */
  .nav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(250,249,247,0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    max-width: var(--max); margin: 0 auto; padding: 0 24px;
    height: 64px; display: flex; align-items: center; gap: 32px;
  }
  .logo { font-size: 1.25rem; font-weight: 800; color: var(--text); }
  .logo span { color: var(--orange); }
  .nav-links { display: flex; gap: 24px; margin-right: auto; }
  .nav-links a { font-size: 0.9rem; font-weight: 500; color: var(--text-muted); transition: color .2s; }
  .nav-links a:hover { color: var(--text); }
  .nav-cta { display: none; }
  @media (min-width: 768px) { .nav-cta { display: inline-flex; } }

  /* ??? Buttons ??? */
  .btn-primary {
    display: inline-flex; align-items: center;
    background: var(--orange); color: #fff;
    border: none; border-radius: 10px;
    padding: 12px 24px; font-size: 0.95rem; font-weight: 600;
    cursor: pointer; transition: background .2s, transform .1s;
    white-space: nowrap;
  }
  .btn-primary:hover { background: var(--orange-dark); transform: translateY(-1px); }
  .btn-white {
    display: inline-flex; align-items: center;
    background: #fff; color: var(--orange);
    border: 2px solid #fff; border-radius: 10px;
    padding: 12px 24px; font-size: 0.95rem; font-weight: 600;
    cursor: pointer; transition: opacity .2s;
    white-space: nowrap;
  }
  .btn-white:hover { opacity: 0.9; }

  /* ??? Badge ??? */
  .badge {
    display: inline-block;
    background: #fff3e0; color: var(--orange-dark);
    border: 1px solid #ffd09a;
    border-radius: 100px; padding: 4px 14px;
    font-size: 0.8rem; font-weight: 600; letter-spacing: .04em;
    text-transform: uppercase; margin-bottom: 16px;
  }

  /* ??? Hero ??? */
  .hero { padding: 80px 0 60px; }
  .hero .container {
    display: grid; grid-template-columns: 1fr;
    gap: 48px; align-items: center;
  }
  @media (min-width: 900px) {
    .hero .container { grid-template-columns: 1fr 1fr; }
    .hero { padding: 100px 0 80px; }
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800; line-height: 1.1;
    letter-spacing: -.02em; margin-bottom: 20px;
    color: var(--text);
  }
  .h1-accent { color: var(--orange); }
  .hero-sub {
    font-size: 1.1rem; color: var(--text-muted);
    line-height: 1.7; max-width: 520px; margin-bottom: 20px;
  }
  .hero-proof {
    display: flex; flex-wrap: wrap; gap: 8px 16px;
    font-size: 0.82rem; font-weight: 600; color: var(--text-muted);
    margin-bottom: 28px;
  }
  .hero-proof .dot { opacity: .4; }
  .waitlist-form {
    display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 12px;
  }
  .waitlist-form input {
    flex: 1; min-width: 220px;
    padding: 12px 16px; border-radius: 10px;
    border: 1.5px solid var(--border);
    font-size: 0.95rem; background: #fff; color: var(--text);
    outline: none;
  }
  .waitlist-form input:focus { border-color: var(--orange); }
  .hero-note { font-size: 0.82rem; color: var(--text-muted); }

  /* ??? Phone mockup ??? */
  .hero-visual { display: flex; justify-content: center; }
  .phone-mockup {
    width: 260px; height: 500px;
    background: #111827;
    border-radius: 36px;
    border: 8px solid #1f2937;
    box-shadow: 0 40px 80px rgba(0,0,0,.25), 0 0 0 1px #374151;
    padding: 24px 20px;
    display: flex; flex-direction: column;
    position: relative;
    overflow: hidden;
  }
  .phone-mockup::before {
    content: '';
    position: absolute; top: 0; left: 50%; transform: translateX(-50%);
    width: 100px; height: 28px;
    background: #111827; border-radius: 0 0 18px 18px; z-index: 10;
  }
  .phone-screen { padding-top: 20px; }
  .mock-balance { font-size: 1.8rem; font-weight: 800; color: #fff; }
  .mock-label { font-size: 0.75rem; color: #9ca3af; margin-bottom: 20px; }
  .mock-cards { display: flex; gap: 10px; margin-bottom: 20px; }
  .mock-card {
    flex: 1; padding: 14px 12px; border-radius: 12px;
    font-size: 0.8rem; font-weight: 600; color: #fff;
  }
  .mc-1 { background: linear-gradient(135deg, #ff8c00, #d45e00); }
  .mc-2 { background: linear-gradient(135deg, #6366f1, #4338ca); }
  .mock-actions { display: flex; gap: 8px; }
  .mock-action {
    flex: 1; background: #1f2937; border-radius: 10px;
    padding: 10px 6px; font-size: 0.75rem; color: #d1d5db;
    text-align: center;
  }

  /* ??? Section headers ??? */
  .section-header { text-align: center; max-width: 560px; margin: 0 auto 48px; }
  .section-header h2 { font-size: clamp(1.6rem, 3.5vw, 2.4rem); font-weight: 800; margin-bottom: 12px; }
  .section-header p { font-size: 1.05rem; color: var(--text-muted); }

  /* --- Features --- */
  .features { padding: 80px 0; background: var(--surface); }
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }
  .feature-card {
    background: #fff; border-radius: var(--radius);
    border: 1px solid var(--border);
    padding: 28px; transition: box-shadow .2s, transform .2s;
  }
  .feature-card:hover { box-shadow: 0 8px 32px rgba(0,0,0,.08); transform: translateY(-2px); }
  .feature-icon { font-size: 2rem; margin-bottom: 14px; }
  .feature-label {
    font-size: 0.72rem; font-weight: 700; letter-spacing: .06em;
    text-transform: uppercase; color: var(--orange);
    margin-bottom: 8px;
  }
  .feature-card h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: 8px; }
  .feature-card p { font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; }

  /* ??? How It Works ??? */
  .how { padding: 80px 0; }
  .steps {
    display: flex; flex-wrap: wrap;
    align-items: flex-start; gap: 12px; justify-content: center;
  }
  .step { flex: 1; min-width: 200px; max-width: 260px; text-align: center; }
  .step-num {
    width: 52px; height: 52px;
    background: var(--orange); color: #fff;
    border-radius: 50%; font-size: 1.4rem; font-weight: 800;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 16px;
  }
  .step h3 { font-size: 1rem; font-weight: 700; margin-bottom: 8px; }
  .step p { font-size: 0.88rem; color: var(--text-muted); line-height: 1.6; }
  .step-arrow {
    font-size: 1.5rem; color: var(--text-muted);
    padding-top: 14px; display: none;
  }
  @media (min-width: 700px) { .step-arrow { display: block; } }

  /* ??? CTA ??? */
  .cta-section { padding: 80px 0; background: var(--surface); }
  .cta-box {
    background: linear-gradient(135deg, var(--orange), var(--orange-dark));
    border-radius: 20px; padding: 60px 40px;
    text-align: center; color: #fff;
  }
  .cta-box h2 { font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 800; margin-bottom: 12px; }
  .cta-box p { font-size: 1rem; opacity: .85; margin-bottom: 32px; }
  .cta-box .waitlist-form { justify-content: center; }
  .cta-box .waitlist-form input {
    background: rgba(255,255,255,.15);
    border-color: rgba(255,255,255,.4);
    color: #fff;
  }
  .cta-box .waitlist-form input::placeholder { color: rgba(255,255,255,.7); }

  /* ??? Footer ??? */
  .footer { padding: 48px 0 32px; border-top: 1px solid var(--border); }
  .footer-inner {
    display: flex; flex-wrap: wrap;
    justify-content: space-between; gap: 24px; margin-bottom: 32px;
  }
  .footer-brand p { font-size: 0.875rem; color: var(--text-muted); margin-top: 8px; max-width: 220px; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; }
  .footer-links a { font-size: 0.875rem; color: var(--text-muted); transition: color .2s; }
  .footer-links a:hover { color: var(--text); }
  .footer-bottom {
    border-top: 1px solid var(--border); padding-top: 20px;
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px;
  }
  .footer-bottom p { font-size: 0.8rem; color: var(--text-muted); }
</style>
