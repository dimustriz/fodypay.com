---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brand">
      <a href="/" class="footer__logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <rect width="32" height="32" rx="8" fill="#FF8C00"/>
          <path d="M8 22L12 10H15L18 18L21 10H24L28 22H25L22.5 14.5L20 22H16L13.5 14.5L11 22H8Z" fill="white"/>
        </svg>
        <span>FodyPay</span>
      </a>
      <p class="footer__tagline">Money moves at your speed.</p>
    </div>

    <nav class="footer__nav" aria-label="Footer navigation">
      <div class="footer__col">
        <h4>Product</h4>
        <a href="#features">Features</a>
        <a href="#how-it-works">How it works</a>
        <a href="#security">Security</a>
        <a href="#download">Download</a>
      </div>
      <div class="footer__col">
        <h4>Company</h4>
        <a href="#">About</a>
        <a href="#">Blog</a>
        <a href="#">Careers</a>
        <a href="#">Press</a>
      </div>
      <div class="footer__col">
        <h4>Legal</h4>
        <a href="#">Privacy Policy</a>
        <a href="#">Terms of Service</a>
        <a href="#">Cookie Policy</a>
      </div>
    </nav>
  </div>

  <div class="footer__disclaimer">
    <p>FodyPay is a financial software interface currently under development by FodyLabs. FodyPay is a technology platform, not a licensed bank, electronic money institution, or virtual asset custodian. Live card issuance, fiat-to-crypto orchestration, and banking infrastructure will be exclusively handled by our fully regulated third-party partners upon official release.</p>
  </div>

  <div class="footer__bottom">
    <p>&copy; 2026 FodyLabs. All rights reserved.</p>
    <div class="footer__socials">
      <a href="#" aria-label="Twitter / X">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.261 5.636 5.903-5.636zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <a href="#" aria-label="Instagram">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
      </a>
      <a href="#" aria-label="LinkedIn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--surface);
    border-top: 1px solid var(--divider);
    padding: 4rem 1.5rem 2rem;
  }

  .footer__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    gap: 4rem;
    margin-bottom: 3rem;
  }

  .footer__brand {
    flex: 1;
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.0625rem;
    margin-bottom: 0.75rem;
  }

  .footer__tagline {
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }

  .footer__nav {
    display: flex;
    gap: 3rem;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer__col h4 {
    font-size: 0.875rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .footer__col a {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    transition: color 0.2s;
  }

  .footer__col a:hover {
    color: var(--text);
  }

  .footer__bottom {
    max-width: 1200px;
    margin: 0 auto;
    padding-top: 1.5rem;
    border-top: 1px solid var(--divider);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .footer__disclaimer {
    max-width: 1200px;
    margin: 0 auto 1.75rem;
    padding: 1.25rem 1rem;
    border: 1px solid var(--divider);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.025);
  }

  .footer__disclaimer p {
    font-size: 0.6875rem;
    line-height: 1.65;
    color: var(--text-secondary);
    opacity: 0.7;
  }

  .footer__bottom p {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .footer__socials {
    display: flex;
    gap: 1rem;
  }

  .footer__socials a {
    color: var(--text-secondary);
    transition: color 0.2s;
    display: flex;
  }

  .footer__socials a:hover {
    color: var(--text);
  }

  @media (max-width: 768px) {
    .footer__inner {
      flex-direction: column;
      gap: 2.5rem;
    }

    .footer__nav {
      flex-wrap: wrap;
      gap: 2rem;
    }
  }

  @media (max-width: 480px) {
    .footer__bottom {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
