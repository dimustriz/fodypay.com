---
// FodyChat (chat.fodylabs.com) embed for FodyPay. Replaces the legacy ChatWidget
// (chat-logic.ts → fodypay-chat-backend) with the standalone FodyChat widget,
// which answers from FODYPAY_CONTEXT and reads/writes history via
// chat.fodylabs.com/api/history.
import type { Lang } from '@/i18n/ui';
import { chatStrings } from '@/i18n/chat';
import { FODYPAY_CONTEXT, FODYPAY_TENANT_ID } from '@/lib/fodypay-context';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const chat = chatStrings[lang] ?? chatStrings.en;

const config = {
  endpoint: 'https://chat.fodylabs.com/api/chat',
  historyEndpoint: 'https://chat.fodylabs.com/api/history',
  container: '#fodychat-root',
  title: chat.title,
  botLabel: chat.aiLabel,
  greeting: chat.greeting,
  placeholder: chat.placeholder,
  hostLabel: chat.hostLabel,
  nudge: chat.nudge,
  // FodyPay is always dark, so pass a flat theme object (no light/dark split).
  theme: {
    '--chat-primary': '#ff8c00',
    '--chat-surface': '#151820',
    '--chat-text': '#e6edf3',
    '--chat-bg': '#0d0f14',
    '--chat-border': 'rgba(255, 255, 255, 0.12)',
    '--chat-header-bg': 'rgba(255, 140, 0, 0.14)',
    '--chat-header-text': '#ffb347',
    '--chat-user-bg': 'rgba(255, 140, 0, 0.22)',
    '--chat-bot-bg': 'rgba(255, 255, 255, 0.08)',
    '--chat-input-bg': '#151820',
  },
  payload: { context: FODYPAY_CONTEXT, tenantId: FODYPAY_TENANT_ID, lang },
};
---

<div id="fodychat-root">
  <button id="chat-engine-fab" type="button" aria-label={chat.openLabel ?? chat.title}>
    <svg xmlns="http://www.w3.org/2000/svg" style="width:22px;height:22px" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
    <span id="chat-engine-badge"></span>
  </button>
</div>
<script type="application/json" id="fodychat-config" set:html={JSON.stringify(config)}></script>
<script src="https://chat.fodylabs.com/chat-engine.js" defer></script>
<script is:inline>
  function readFodychatConfig() {
    try { return JSON.parse(document.getElementById('fodychat-config').textContent); } catch (e) { return null; }
  }
  function ensureMounted() {
    if (!window.ChatEngine) return;
    if (document.getElementById('chat-engine-panel')) return;
    var cfg = readFodychatConfig();
    if (cfg) ChatEngine.mount(cfg);
  }
  window.addEventListener('load', ensureMounted);
  // Re-mount / re-theme after a ViewTransition (language switch). chat-engine.js
  // self-heals the panel too; here we also refresh theme + title from the config.
  document.addEventListener('astro:page-load', function () {
    ensureMounted();
    var cfg = readFodychatConfig();
    if (!cfg) return;
    var fab = document.getElementById('chat-engine-fab');
    var panel = document.getElementById('chat-engine-panel');
    if (!fab || !panel) return;
    if (cfg.theme) for (var k in cfg.theme) { fab.style.setProperty(k, cfg.theme[k]); panel.style.setProperty(k, cfg.theme[k]); }
    var titleSpan = panel.querySelector('#chat-engine-header span span');
    if (titleSpan && cfg.title) titleSpan.textContent = cfg.title;
  });
</script>

<style is:global>
  #chat-engine-fab {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ff8c00;
    color: #fff;
    z-index: 2147483000;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    opacity: 0.65;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  #chat-engine-fab:hover,
  #chat-engine-fab:focus-visible { opacity: 1; }
  #chat-engine-badge {
    position: absolute;
    top: -3px;
    right: -3px;
    min-width: 18px;
    height: 18px;
    border-radius: 9px;
    background: #ef4444;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0 5px;
    box-sizing: border-box;
  }
</style>
