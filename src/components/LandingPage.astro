---
import { useTranslations, langNames, langs, langPath, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const currentLangName = langNames[lang];
---

<!-- Nav -->
<header class="nav">
  <div class="nav-inner">
    <a href={langPath(lang)} class="logo">Fody<span>Pay</span></a>

    <nav class="nav-links" id="nav-links">
      <a href={langPath(lang, '#why')}>{t('nav.why')}</a>
      <a href={langPath(lang, '#how-it-works')}>{t('nav.how')}</a>
      <a href="/privacy">{t('nav.privacy')}</a>
      <a href="/terms">{t('nav.terms')}</a>
      <div class="nav-lang-mobile">
        {langs.map(l => (
          <a href={langPath(l)} class:list={[{ 'active': l === lang }]}>
            {langNames[l]}
          </a>
        ))}
      </div>
    </nav>

    <div class="nav-right">
      <!-- Language switcher -->
      <div class="lang-switcher">
        <button class="lang-btn" aria-expanded="false" aria-haspopup="true">
          {lang.toUpperCase()} <span class="lang-arrow">&#9660;</span>
        </button>
        <div class="lang-dropdown" hidden role="menu">
          {langs.map(l => (
            <a href={langPath(l)} class:list={['lang-opt', { active: l === lang }]} role="menuitem">
              {langNames[l]}
            </a>
          ))}
        </div>
      </div>

      <!-- Theme toggle -->
      <button class="theme-toggle" aria-label={t('theme.dark')}>
        <span class="icon-sun">&#9788;</span>
        <span class="icon-moon">&#9790;</span>
      </button>

      <!-- Hamburger -->
      <button class="burger" aria-expanded="false" aria-controls="nav-links" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>

      <a href={langPath(lang, '#waitlist')} class="btn-primary nav-cta">{t('nav.cta')}</a>
    </div>
  </div>
</header>

<!-- Hero -->
<section class="hero">
  <div class="container">
    <div class="hero-content">
      <span class="badge">{t('hero.badge')}</span>
      <h1>{t('hero.h1')}<br><span class="h1-accent">{t('hero.h1accent')}</span></h1>
      <p class="hero-sub">{t('hero.sub')}</p>
      <div class="hero-proof">
        <span>{t('hero.proof1')}</span>
        <span class="dot">&middot;</span>
        <span>{t('hero.proof2')}</span>
        <span class="dot">&middot;</span>
        <span>{t('hero.proof3')}</span>
      </div>
      <form class="waitlist-form" id="waitlist" action="#" method="POST">
        <input type="email" name="email" placeholder={t('hero.email')} required />
        <button type="submit" class="btn-primary">{t('hero.cta')}</button>
      </form>
      <p class="hero-note">{t('hero.note')}</p>
    </div>
    <div class="hero-visual">
      <div class="phone-mockup">
        <div class="phone-screen">
          <div class="mock-balance">$12,480.50</div>
          <div class="mock-label">Total Balance</div>
          <div class="mock-cards">
            <div class="mock-card mc-1">&bull;&bull;&bull;&bull; 4291</div>
            <div class="mock-card mc-2">FodyPay Visa</div>
          </div>
          <div class="mock-actions">
            <div class="mock-action">&#8593; Send</div>
            <div class="mock-action">&#8595; Receive</div>
            <div class="mock-action">+ Top Up</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Why FodyPay -->
<section class="features" id="why">
  <div class="container">
    <div class="section-header">
      <h2>{t('feat.h2')}</h2>
      <p>{t('feat.sub')}</p>
    </div>
    <div class="features-grid">
      {(['f1','f2','f3','f4','f5','f6'] as const).map(f => (
        <div class="feature-card">
          <div class="feature-label">{t(`${f}.label`)}</div>
          <h3>{t(`${f}.h3`)}</h3>
          <p>{t(`${f}.p`)}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- How It Works -->
<section class="how" id="how-it-works">
  <div class="container">
    <div class="section-header">
      <h2>{t('how.h2')}</h2>
      <p>{t('how.sub')}</p>
    </div>
    <div class="steps">
      <div class="step">
        <div class="step-num">1</div>
        <h3>{t('how.s1.h3')}</h3>
        <p>{t('how.s1.p')}</p>
      </div>
      <div class="step-arrow">&#8594;</div>
      <div class="step">
        <div class="step-num">2</div>
        <h3>{t('how.s2.h3')}</h3>
        <p>{t('how.s2.p')}</p>
      </div>
      <div class="step-arrow">&#8594;</div>
      <div class="step">
        <div class="step-num">3</div>
        <h3>{t('how.s3.h3')}</h3>
        <p>{t('how.s3.p')}</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta-section">
  <div class="container">
    <div class="cta-box">
      <h2>{t('cta.h2')}</h2>
      <p>{t('cta.p')}</p>
      <form class="waitlist-form" action="#" method="POST">
        <input type="email" name="email" placeholder={t('cta.email')} required />
        <button type="submit" class="btn-white">{t('cta.btn')}</button>
      </form>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="footer">
  <div class="container">
    <div class="footer-inner">
      <div class="footer-brand">
        <a href={langPath(lang)} class="logo">Fody<span>Pay</span></a>
        <p>{t('footer.tagline')}</p>
      </div>
      <div class="footer-links">
        <a href={langPath(lang, '#why')}>{t('footer.features')}</a>
        <a href={langPath(lang, '#how-it-works')}>{t('footer.how')}</a>
        <a href="/privacy">{t('footer.privacy')}</a>
        <a href="/terms">{t('footer.terms')}</a>
        <a href="mailto:hello@fodypay.com">{t('footer.contact')}</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>{t('footer.rights')}</p>
      <p>{t('footer.payment')}</p>
    </div>
  </div>
</footer>

<style is:global>
  /* ===== CSS Variables ===== */
  :root {
    --orange: #ff8c00;
    --orange-dark: #d45e00;
    --bg: #faf9f7;
    --surface: #f2f1ee;
    --card-bg: #ffffff;
    --text: #111827;
    --text-muted: #6b7280;
    --border: #e5e3de;
    --nav-bg: rgba(250,249,247,0.9);
    --input-bg: #ffffff;
    --radius: 14px;
    --max: 1120px;
  }
  [data-theme="dark"] {
    --bg: #0f172a;
    --surface: #1e293b;
    --card-bg: #1e293b;
    --text: #f1f5f9;
    --text-muted: #94a3b8;
    --border: #334155;
    --nav-bg: rgba(15,23,42,0.92);
    --input-bg: #1e293b;
  }

  body { background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif; margin: 0; }
  *, *::before, *::after { box-sizing: border-box; }
  a { text-decoration: none; color: inherit; }

  .container { max-width: var(--max); margin: 0 auto; padding: 0 20px; }

  /* ===== Nav ===== */
  .nav {
    position: sticky; top: 0; z-index: 100;
    background: var(--nav-bg);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    max-width: var(--max); margin: 0 auto; padding: 0 20px;
    height: 64px; display: flex; align-items: center; gap: 24px;
  }
  .logo { font-size: 1.25rem; font-weight: 800; color: var(--text); flex-shrink: 0; }
  .logo span { color: var(--orange); }

  .nav-links {
    display: flex; gap: 20px; margin-right: auto;
  }
  .nav-links a { font-size: 0.9rem; font-weight: 500; color: var(--text-muted); transition: color .2s; white-space: nowrap; }
  .nav-links a:hover { color: var(--text); }

  .nav-right { display: flex; align-items: center; gap: 12px; margin-left: auto; }

  /* Language switcher */
  .lang-switcher { position: relative; }
  .lang-btn {
    background: none; border: 1px solid var(--border); border-radius: 8px;
    padding: 6px 10px; font-size: 0.8rem; font-weight: 600;
    color: var(--text-muted); cursor: pointer; transition: border-color .2s, color .2s;
    display: flex; align-items: center; gap: 4px;
  }
  .lang-btn:hover { color: var(--text); border-color: var(--text-muted); }
  .lang-arrow { font-size: 0.65rem; }
  .lang-dropdown {
    position: absolute; top: calc(100% + 8px); right: 0;
    background: var(--card-bg); border: 1px solid var(--border);
    border-radius: 12px; padding: 8px 0; min-width: 150px;
    box-shadow: 0 8px 24px rgba(0,0,0,.12);
    z-index: 200;
  }
  .lang-opt {
    display: block; padding: 8px 16px;
    font-size: 0.88rem; color: var(--text-muted);
    transition: background .15s, color .15s;
  }
  .lang-opt:hover { background: var(--surface); color: var(--text); }
  .lang-opt.active { color: var(--orange); font-weight: 600; }

  /* Theme toggle */
  .theme-toggle {
    background: none; border: 1px solid var(--border); border-radius: 8px;
    width: 36px; height: 36px; cursor: pointer; font-size: 1.1rem;
    display: flex; align-items: center; justify-content: center;
    color: var(--text-muted); transition: border-color .2s, color .2s;
    flex-shrink: 0;
  }
  .theme-toggle:hover { color: var(--text); border-color: var(--text-muted); }
  .icon-moon { display: none; }
  [data-theme="dark"] .icon-sun { display: none; }
  [data-theme="dark"] .icon-moon { display: inline; }

  /* Lang section inside hamburger menu - hidden on desktop */
  .nav-lang-mobile { display: none; }

  /* Hamburger */
  .burger {
    display: none; flex-direction: column; justify-content: space-between;
    width: 36px; height: 36px; padding: 8px;
    background: none; border: 1px solid var(--border); border-radius: 8px;
    cursor: pointer; flex-shrink: 0;
  }
  .burger span {
    display: block; height: 2px; background: var(--text-muted);
    border-radius: 2px; transition: transform .25s, opacity .25s;
  }
  .burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .nav-cta { display: none; }

  /* Mobile nav */
  @media (max-width: 767px) {
    .nav-links {
      display: none; position: absolute; top: 64px; left: 0; right: 0;
      background: var(--bg); border-bottom: 1px solid var(--border);
      padding: 16px 20px; flex-direction: column; gap: 0;
    }
    .nav-links.open { display: flex; }
    .nav-links > a { padding: 12px 0; border-bottom: 1px solid var(--border); font-size: 1rem; }
    .burger { display: flex; }
    /* hide lang dropdown from header; show inline language list inside hamburger */
    .lang-switcher { display: none; }
    .nav-lang-mobile {
      display: flex; flex-wrap: wrap; gap: 8px;
      padding-top: 14px; margin-top: 4px;
      border-top: 1px solid var(--border);
    }
    .nav-lang-mobile a {
      padding: 6px 12px; border-radius: 8px; font-size: 0.82rem; font-weight: 500;
      border: 1px solid var(--border); color: var(--text-muted);
    }
    .nav-lang-mobile a.active { color: var(--orange); border-color: var(--orange); font-weight: 600; }
  }
  @media (min-width: 768px) {
    .nav-cta { display: inline-flex; }
    .nav-links { display: flex !important; position: static; background: none; border: none; padding: 0; flex-direction: row; }
    .nav-links a { padding: 0; border: none; font-size: 0.9rem; }
  }

  /* ===== Buttons ===== */
  .btn-primary {
    display: inline-flex; align-items: center;
    background: var(--orange); color: #fff;
    border: none; border-radius: 10px;
    padding: 12px 22px; font-size: 0.9rem; font-weight: 600;
    cursor: pointer; transition: background .2s, transform .1s;
    white-space: nowrap;
  }
  .btn-primary:hover { background: var(--orange-dark); transform: translateY(-1px); }
  .btn-white {
    display: inline-flex; align-items: center;
    background: #fff; color: var(--orange);
    border: 2px solid #fff; border-radius: 10px;
    padding: 12px 22px; font-size: 0.9rem; font-weight: 600;
    cursor: pointer; transition: opacity .2s; white-space: nowrap;
  }
  .btn-white:hover { opacity: 0.9; }

  /* ===== Badge ===== */
  .badge {
    display: inline-block;
    background: #fff3e0; color: var(--orange-dark);
    border: 1px solid #ffd09a; border-radius: 100px;
    padding: 4px 14px; font-size: 0.78rem; font-weight: 600;
    letter-spacing: .04em; text-transform: uppercase; margin-bottom: 16px;
  }
  [data-theme="dark"] .badge { background: rgba(255,140,0,.15); border-color: rgba(255,140,0,.3); }

  /* ===== Hero ===== */
  .hero { padding: 60px 0 48px; }
  .hero .container {
    display: grid; grid-template-columns: 1fr;
    gap: 40px; align-items: center;
  }
  @media (min-width: 900px) {
    .hero .container { grid-template-columns: 1fr 1fr; }
    .hero { padding: 100px 0 80px; }
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 800; line-height: 1.1;
    letter-spacing: -.02em; margin-bottom: 18px;
  }
  .h1-accent { color: var(--orange); }
  .hero-sub { font-size: 1.05rem; color: var(--text-muted); line-height: 1.7; max-width: 520px; margin-bottom: 20px; }
  .hero-proof {
    display: flex; flex-wrap: wrap; gap: 6px 14px;
    font-size: 0.8rem; font-weight: 600; color: var(--text-muted); margin-bottom: 24px;
  }
  .hero-proof .dot { opacity: .4; }
  .waitlist-form { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 10px; }
  .waitlist-form input {
    flex: 1; min-width: 200px;
    padding: 12px 16px; border-radius: 10px;
    border: 1.5px solid var(--border);
    font-size: 0.92rem; background: var(--input-bg); color: var(--text);
    outline: none;
  }
  .waitlist-form input:focus { border-color: var(--orange); }
  .hero-note { font-size: 0.8rem; color: var(--text-muted); }

  /* Phone mockup */
  .hero-visual { display: flex; justify-content: center; }
  .phone-mockup {
    width: 240px; height: 460px;
    background: #111827; border-radius: 36px;
    border: 8px solid #1f2937;
    box-shadow: 0 40px 80px rgba(0,0,0,.25), 0 0 0 1px #374151;
    padding: 24px 18px; display: flex; flex-direction: column;
    position: relative; overflow: hidden;
  }
  .phone-mockup::before {
    content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%);
    width: 90px; height: 26px; background: #111827;
    border-radius: 0 0 16px 16px; z-index: 10;
  }
  .phone-screen { padding-top: 18px; }
  .mock-balance { font-size: 1.6rem; font-weight: 800; color: #fff; }
  .mock-label { font-size: 0.72rem; color: #9ca3af; margin-bottom: 18px; }
  .mock-cards { display: flex; gap: 8px; margin-bottom: 18px; }
  .mock-card { flex: 1; padding: 12px 10px; border-radius: 10px; font-size: 0.75rem; font-weight: 600; color: #fff; }
  .mc-1 { background: linear-gradient(135deg, #ff8c00, #d45e00); }
  .mc-2 { background: linear-gradient(135deg, #6366f1, #4338ca); }
  .mock-actions { display: flex; gap: 6px; }
  .mock-action { flex: 1; background: #1f2937; border-radius: 8px; padding: 8px 4px; font-size: 0.7rem; color: #d1d5db; text-align: center; }

  /* ===== Section headers ===== */
  .section-header { text-align: center; max-width: 560px; margin: 0 auto 44px; }
  .section-header h2 { font-size: clamp(1.5rem, 3.5vw, 2.3rem); font-weight: 800; margin-bottom: 12px; }
  .section-header p { font-size: 1rem; color: var(--text-muted); }

  /* ===== Features ===== */
  .features { padding: 72px 0; background: var(--surface); }
  .features-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; }
  .feature-card {
    background: var(--card-bg); border-radius: var(--radius);
    border: 1px solid var(--border); padding: 24px;
    transition: box-shadow .2s, transform .2s;
  }
  .feature-card:hover { box-shadow: 0 8px 32px rgba(0,0,0,.08); transform: translateY(-2px); }
  .feature-label { font-size: 0.7rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--orange); margin-bottom: 8px; }
  .feature-card h3 { font-size: 1rem; font-weight: 700; margin-bottom: 8px; }
  .feature-card p { font-size: 0.88rem; color: var(--text-muted); line-height: 1.6; margin: 0; }

  /* ===== How It Works ===== */
  .how { padding: 72px 0; }
  .steps { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 12px; justify-content: center; }
  .step { flex: 1; min-width: 180px; max-width: 240px; text-align: center; }
  .step-num {
    width: 50px; height: 50px; background: var(--orange); color: #fff;
    border-radius: 50%; font-size: 1.3rem; font-weight: 800;
    display: flex; align-items: center; justify-content: center; margin: 0 auto 14px;
  }
  .step h3 { font-size: 0.95rem; font-weight: 700; margin-bottom: 8px; }
  .step p { font-size: 0.85rem; color: var(--text-muted); line-height: 1.6; margin: 0; }
  .step-arrow { font-size: 1.4rem; color: var(--text-muted); padding-top: 12px; display: none; }
  @media (min-width: 700px) { .step-arrow { display: block; } }

  /* ===== CTA ===== */
  .cta-section { padding: 72px 0; background: var(--surface); }
  .cta-box {
    background: linear-gradient(135deg, var(--orange), var(--orange-dark));
    border-radius: 20px; padding: 52px 32px; text-align: center; color: #fff;
  }
  .cta-box h2 { font-size: clamp(1.3rem, 3vw, 1.9rem); font-weight: 800; margin-bottom: 10px; }
  .cta-box p { font-size: 1rem; opacity: .85; margin-bottom: 28px; }
  .cta-box .waitlist-form { justify-content: center; }
  .cta-box .waitlist-form input { background: rgba(255,255,255,.15); border-color: rgba(255,255,255,.4); color: #fff; }
  .cta-box .waitlist-form input::placeholder { color: rgba(255,255,255,.7); }

  /* ===== Footer ===== */
  .footer { padding: 44px 0 28px; border-top: 1px solid var(--border); }
  .footer-inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 20px; margin-bottom: 28px; }
  .footer-brand p { font-size: 0.85rem; color: var(--text-muted); margin-top: 8px; max-width: 220px; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; }
  .footer-links a { font-size: 0.85rem; color: var(--text-muted); transition: color .2s; }
  .footer-links a:hover { color: var(--text); }
  .footer-bottom { border-top: 1px solid var(--border); padding-top: 18px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; }
  .footer-bottom p { font-size: 0.78rem; color: var(--text-muted); margin: 0; }

  /* ===== Mobile spacing ===== */
  @media (max-width: 480px) {
    .hero { padding: 40px 0 32px; }
    .features, .how, .cta-section { padding: 52px 0; }
    .cta-box { padding: 36px 20px; }
    .waitlist-form { flex-direction: column; }
    .waitlist-form input { min-width: unset; width: 100%; }
    .btn-primary, .btn-white { width: 100%; justify-content: center; }
    .features-grid { grid-template-columns: 1fr; }
    .steps { flex-direction: column; align-items: center; }
    .step { max-width: 100%; }
  }
</style>

<script>
  // Theme toggle
  const themeBtn = document.querySelector('.theme-toggle') as HTMLButtonElement | null;
  themeBtn?.addEventListener('click', () => {
    const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('fp-theme', next);
  });

  // Hamburger
  const burger = document.querySelector('.burger') as HTMLButtonElement | null;
  const navLinks = document.querySelector('.nav-links') as HTMLElement | null;
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    navLinks?.classList.toggle('open', !open);
  });
  // Close mobile nav on link click
  navLinks?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    burger?.setAttribute('aria-expanded', 'false');
    navLinks.classList.remove('open');
  }));

  // Language switcher
  const langBtn = document.querySelector('.lang-btn') as HTMLButtonElement | null;
  const langDrop = document.querySelector('.lang-dropdown') as HTMLElement | null;
  langBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const hidden = langDrop?.hasAttribute('hidden');
    if (hidden) { langDrop?.removeAttribute('hidden'); langBtn.setAttribute('aria-expanded', 'true'); }
    else { langDrop?.setAttribute('hidden', ''); langBtn.setAttribute('aria-expanded', 'false'); }
  });
  document.addEventListener('click', () => {
    langDrop?.setAttribute('hidden', '');
    langBtn?.setAttribute('aria-expanded', 'false');
  });
</script>
