---

<section class="cta" id="download">
  <div class="cta__glow" aria-hidden="true"></div>
  <div class="cta__inner">
    <h2 class="cta__title">Ready to take control<br />of your money?</h2>
    <p class="cta__sub">
      Join thousands of people already using FodyPay. Free to download, free to use.
    </p>

    <div class="cta__stores">
      <a href="#" class="store-btn" aria-label="Download on the App Store">
        <svg class="store-btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
        </svg>
        <div>
          <span class="store-btn__sub">Download on the</span>
          <span class="store-btn__name">App Store</span>
        </div>
      </a>

      <a href="#" class="store-btn" aria-label="Get it on Google Play">
        <svg class="store-btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M3.18 23.97c.27.15.59.14.85-.01l12.88-7.46-2.76-2.76-10.97 10.23zM20.49 10.72L17.2 8.87l-3.1 3.1 3.1 3.1 3.32-1.93c.95-.55.95-1.88-.03-2.42zM2.01.03C1.74.19 1.56.48 1.56.8v22.4c0 .32.18.61.45.77l11.52-11.97L2.01.03zM3.18.03L14.15 11l-2.76 2.76L.3.54C.56.39.88.38 3.18.03z"/>
        </svg>
        <div>
          <span class="store-btn__sub">Get it on</span>
          <span class="store-btn__name">Google Play</span>
        </div>
      </a>
    </div>

    <p class="cta__disclaimer">Free download · No credit card required</p>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    padding: 6rem 1.5rem;
    text-align: center;
  }

  .cta__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 100%, rgba(255,140,0,0.12) 0%, transparent 65%);
    pointer-events: none;
  }

  .cta__inner {
    max-width: 640px;
    margin: 0 auto;
    position: relative;
  }

  .cta__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .cta__sub {
    color: var(--text-secondary);
    font-size: 1.0625rem;
    margin-bottom: 2.5rem;
  }

  .cta__stores {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .store-btn {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    background: var(--surface);
    border: 1.5px solid var(--elevated);
    border-radius: 14px;
    padding: 0.875rem 1.5rem;
    transition: border-color 0.2s, transform 0.15s;
    min-width: 180px;
  }

  .store-btn:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
  }

  .store-btn__icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
  }

  .store-btn div {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .store-btn__sub {
    font-size: 0.6875rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .store-btn__name {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .cta__disclaimer {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }
</style>
