---
import ChatWidget from '@/components/ChatWidget.astro';
import { chatStrings } from '@/i18n/chat';
import type { Lang } from '@/i18n/ui';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}

const {
  title,
  description = 'FodyPay — send, receive, and manage money with ease. The modern digital wallet built for everyone.',
  lang = 'en',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <ChatWidget
      i={{ chat: chatStrings[lang] }}
      tenantId="fodypay"
      tenantName="FodyPay"
    />
  </body>
</html>

<style is:global>
  :root {
    --primary: #ff8c00;
    --primary-dark: #d45e00;
    --primary-light: #ffb347;
    --success: #00c896;
    --danger: #ff3b30;
    --warning: #ffc837;

    --bg: #0d0f14;
    --surface: #151820;
    --elevated: #1d2030;
    --text: #ffffff;
    --text-secondary: #7e8299;
    --text-tertiary: #3d4155;
    --divider: #1d2030;

    /* Mapped onto the chat widget's own design tokens so it inherits the
       FodyPay theme (the widget otherwise defaults to a generic blue/dark
       palette). */
    --color-primary: var(--primary);
    --primary-rgb: 255, 140, 0;
    --color-surface: var(--surface);
    --color-surface-border: var(--divider);
    --color-text: var(--text);
    --color-bg: var(--bg);
    --color-pill-text: var(--text-secondary);
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background-color: var(--bg);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img, svg {
    display: block;
    max-width: 100%;
  }

  button {
    font-family: inherit;
    cursor: pointer;
  }
</style>
